# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

#Tailscale
Host homelab
    HostName homelab.tail3bbaa1.ts.net
    User jason
    StrictHostKeyChecking accept-new
Host cloudlab
    HostName cloudlab.tail3bbaa1.ts.net
    User ubuntu
    StrictHostKeyChecking accept-new
Host runner-01
    HostName runner-01.tail3bbaa1.ts.net
    User ubuntu
    StrictHostKeyChecking accept-new
Host htpc
    HostName htpc.tail3bbaa1.ts.net
    User jason
    StrictHostKeyChecking accept-new

Host 104.0.3.52
  HostName 104.0.3.52
  User jason
  Port 69
  StrictHostKeyChecking yes
Host 104.178.183.20
  HostName 104.178.183.20
  User jason
  Port 69
  StrictHostKeyChecking yes
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_rsa
  IdentitiesOnly yes
Host *
  ServerAliveInterval 30
  ServerAliveCountMax 6
  TCPKeepAlive yes 
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_ed25519
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  StrictHostKeyChecking yes
  ForwardAgent no

  # Faster & more resilient SSH connections
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist yes
