#!/usr/bin/env bash

# Get project name dynamically from Makefile
SESSION=$(make -s tmux-name)

# Prevent duplicates
if tmux has-session -t "$SESSION" 2>/dev/null; then
  tmux attach -t "$SESSION"
  exit 0
fi

# Create session
tmux new-session -d -s "$SESSION" -n overview

# --- Window 1: Overview ---
tmux send-keys -t "$SESSION" "make status" C-m
tmux split-window -v -t "$SESSION"
tmux send-keys -t "$SESSION" "watch -n 2 make status" C-m

# --- Window 2: Backend logs ---
tmux new-window -t "$SESSION" -n backend
tmux send-keys -t "$SESSION" "make shell-backend" C-m
tmux send-keys -t "$SESSION" "make dev" C-m
tmux split-window -v -t "$SESSION"
tmux send-keys -t "$SESSION" "make logs-backend" C-m


# --- Window 3: Frontend logs ---
tmux new-window -t "$SESSION" -n frontend
tmux send-keys -t "$SESSION" "make logs-frontend" C-m

# --- Window 4: Sync logs ---
tmux new-window -t "$SESSION" -n sync
tmux send-keys -t "$SESSION" "make logs-sync" C-m

# --- Window 5: Shell ---
tmux new-window -t "$SESSION" -n shell
tmux split-window -h -t "$SESSION"

#tmux send-keys -t "$SESSION":shell.0 "make shell-backend" C-m
#tmux send-keys -t "$SESSION":shell.1 "zsh" C-m

# --- Window 6: Control ---
tmux new-window -t "$SESSION" -n control
tmux send-keys -t "$SESSION" "make up" C-m

# Focus first window
tmux select-window -t "$SESSION:overview"

tmux attach -t "$SESSION"
